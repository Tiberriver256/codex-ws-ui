{
  "name": "@tiberriver256/codex-web-ui",
  "version": "1.0.0",
  "description": "Local WebSocket UI for the Codex TypeScript SDK",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:mock": "CODEX_MOCK=1 node server.mjs",
    "test": "CODEX_MOCK=1 node test-mock.mjs",
    "test:e2e": "npx playwright test",
    "test:bdd": "cucumber-js"
  },
  "bin": {
    "codex-web-ui": "./bin/codex-web-ui.js"
  },
  "keywords": [
    "codex",
    "websocket",
    "ui",
    "openai"
  ],
  "author": "",
  "license": "ISC",
  "files": [
    "public",
    "bin",
    "server.mjs",
    "server-utils.mjs",
    "mock-codex.mjs",
    "README.md",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.87.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.5.0",
    "@playwright/test": "^1.55.1",
    "playwright": "^1.57.0"
  }
}
